{
    "name": "pieceofcake2/acl_menu",
    "description": "CakePHP 2 component that builds navigation menus of the actions a user may access with ACL",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "acl", "menu", "navigation"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Story",
            "homepage": "https://mark-story.com",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "suggest": {
        "pieceofcake2/acl_extras": "Creates the ACO nodes of all controllers and actions",
        "pieceofcake2/menu_builder": "Renders the menu"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "AclMenu"
    }
}
